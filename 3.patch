-  let terminalPid = null;
-  _pidChain = [];
-  _detectedEditor = null;
-  _claudePid = null;
-  const claudeNames = isWin ? CLAUDE_NAMES_WIN : CLAUDE_NAMES_MAC;
-  for (let i = 0; i < 8; i++) {
-    let name, parentPid;
